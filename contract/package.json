{
  "name": "@corpopay/contract",
  "version": "0.4.0",
  "description": "CorpoPay API contract — generated OpenAPI types and Prisma enums.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-dist.mjs"
  }
}

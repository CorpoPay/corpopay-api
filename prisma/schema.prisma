// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  DISABLED
}

enum Environment {
  SANDBOX
  PRODUCTION
}

enum UserRole {
  OWNER
  STAFF
  SUPPORT_ADMIN
  SUPER_ADMIN
}

enum Provider {
  NAPS
  VPS
  STRIPE
  PAYPAL
  ADYEN
}

enum ProviderConfigStatus {
  CONNECTED
  INVALID
  MISSING
  DISABLED
}

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ProviderHealthStatus {
  NORMAL
  DEGRADED
  DOWN
}

enum AuditAction {
  PROVIDER_CONFIG_CREATED
  PROVIDER_CONFIG_UPDATED
  PROVIDER_CONFIG_DELETED
  PROVIDER_CONFIG_VALIDATED
  PROVIDER_CONFIG_DISABLED
  PROVIDER_CONFIG_ENABLED
  REFUND_INITIATED
  REFUND_SUCCEEDED
  REFUND_FAILED
  API_KEY_CREATED
  API_KEY_REVOKED
  TENANT_DISABLED
  TENANT_ENABLED
  USER_INVITED
  USER_ROLE_CHANGED
  USER_REMOVED
  PAYMENT_LINK_CANCELED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELED
  INSTALLMENT_PLAN_CREATED
  INSTALLMENT_PLAN_UPDATED
  INSTALLMENT_PLAN_DELETED
  INSTALLMENT_AGREEMENT_CANCELLED
}

enum InstallmentAgreementStatus {
  PENDING_CHECKOUT
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

// ─── Ledger / PayFac settlement ───────────────────────────────────────────────

// A tenant's double-entry settlement accounts. Balances are always DERIVED from
// LedgerEntry rows (never a mutable counter); see src/lib/ledger.ts.
enum LedgerAccount {
  CASH      // actual money in CorpoPay's pool attributable to the tenant (asset)
  PENDING   // captured but not yet settled by the provider (asset)
  COLLECTED // gross customer funds owed to the tenant (liability)
  AVAILABLE // subset of collected eligible for payout (liability)
  RESERVE   // held back against reversals (liability)
  FEES      // CorpoPay revenue (income)
  PAID_OUT  // cumulative amount settled to the tenant (contra-liability)
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerCategory {
  CAPTURE
  REFUND
  FEE
  SPLIT
  PAYOUT
  CHARGEBACK
  RESERVE_RELEASE
  ADJUSTMENT
  DISBURSEMENT
}

enum FeeType {
  FLAT
  PERCENTAGE
  PER_METHOD
  TIERED
}

enum AvailabilityMode {
  IMMEDIATE
  DELAY
  ON_FULFILLMENT
  ON_COLLECTION
}

enum PayoutSchedule {
  MANUAL
  AUTO_DAILY
  AUTO_WEEKLY
  AUTO_MONTHLY
  THRESHOLD
  INSTANT
}

enum ReserveType {
  NONE
  FIXED
  ROLLING
}

enum ReversalFundingPolicy {
  NET_FROM_AVAILABLE
  DEBIT_RESERVE
  INVOICE_TENANT
  ALLOW_NEGATIVE
}

enum PayoutStatus {
  DRAFT
  SCHEDULED
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  CARD
  WALLET
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

enum RecoveryStatus {
  PENDING
  COLLECTED
  WAIVED
}

enum SplitTrigger {
  AT_CAPTURE
  ON_USAGE
  MANUAL
}

enum SplitPartyType {
  PLATFORM
  SUB_MERCHANT
  VENDOR
  AFFILIATE
  ESCROW
}

enum SplitStatus {
  PENDING
  SETTLED
  REVERSED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
  RESOLVED
}

enum ReconciliationMatchStatus {
  UNMATCHED
  EXACT
  AMOUNT_DIFF
}

// ─── Models ─────────────────────────────────────────────────────────────────────

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  status           TenantStatus @default(ACTIVE)
  environment      Environment  @default(SANDBOX)
  notifyEmail      String?      // optional: send payment outcome emails via configured adapter
  notifyWebhookUrl String?      // optional: outbound webhook URL for real-time payment events
  webhookSigningSecret String?  // AES-256 encrypted HMAC secret for signing outbound merchant webhooks
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users                 User[]
  providerConfigs       ProviderConfig[]
  paymentLinks          PaymentLink[]
  paymentIntents        PaymentIntent[]
  refunds               Refund[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  webhookEvents         WebhookEvent[]
  subscriptions         Subscription[]
  installmentPlans      InstallmentPlan[]
  installmentAgreements InstallmentAgreement[]
  ledgerEntries         LedgerEntry[]
  feeSchedules          FeeSchedule[]
  settlementPolicies    SettlementPolicy[]
  payouts               Payout[]
  disputes              Dispute[]
  recoveries            Recovery[]
  splitParties          SplitParty[]
  splitRules            SplitRule[]
  splits                Split[]
  reconciliationReports ReconciliationReport[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds   Refund[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model ProviderConfig {
  id                   String               @id @default(cuid())
  tenantId             String
  provider             Provider
  encryptedCredentials String               // AES-256 encrypted JSON
  status               ProviderConfigStatus @default(MISSING)
  environment          Environment          @default(SANDBOX)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("provider_configs")
}

model PaymentLink {
  id            String            @id @default(cuid())
  tenantId      String
  slug          String            @unique @default(cuid())
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("MAD")
  description   String
  reference     String
  customerName  String?
  customerEmail String?
  customerPhone String?
  provider      Provider
  status        PaymentLinkStatus @default(ACTIVE)
  maxAttempts   Int               @default(1)
  attemptCount  Int               @default(0)
  expiresAt     DateTime?
  // ── Recurring billing ──────────────────────────────────────────
  isRecurring     Boolean          @default(false)
  billingInterval BillingInterval?
  intervalValue   Int?             @default(1)
  maxRetries      Int              @default(3)
  // ── BNPL / Installments ─────────────────────────────────────────
  isInstallment   Boolean          @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentIntents        PaymentIntent[]
  subscriptions         Subscription[]
  installmentAgreements InstallmentAgreement[]

  @@index([tenantId])
  @@index([slug])
  @@map("payment_links")
}

model PaymentIntent {
  id             String              @id @default(cuid())
  tenantId       String
  paymentLinkId  String?             // null for direct/programmatic payment intents (no Payment Link)
  status         PaymentIntentStatus @default(CREATED)
  provider       Provider
  providerRef    String?
  correlationId  String              @unique @default(cuid())
  providerData   Json?               // { paywallUrl, payload, signature, mode } — served by hosted relay page
  customerIp     String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentLink           PaymentLink?          @relation(fields: [paymentLinkId], references: [id])
  providerTxs           ProviderTransaction[]
  refunds               Refund[]
  webhookEvents         WebhookEvent[]
  subscription          Subscription?         // set when the intent initiated a recurring subscription
  installmentAgreement  InstallmentAgreement? // set when the intent initiated a BNPL agreement
  disputes              Dispute[]               // chargebacks raised against this intent

  @@index([tenantId])
  @@index([providerRef])
  @@map("payment_intents")
}

model ProviderTransaction {
  id                    String   @id @default(cuid())
  paymentIntentId       String
  provider              Provider
  providerTransactionId String?
  rawRequest            Json?    // masked before storage
  rawResponse           Json?    // masked before storage
  createdAt             DateTime @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
  @@map("provider_transactions")
}

model Refund {
  id               String       @id @default(cuid())
  paymentIntentId  String
  tenantId         String
  initiatedBy      String       // userId
  status           RefundStatus @default(PENDING)
  providerRefundRef String?
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("MAD")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiator     User          @relation(fields: [initiatedBy], references: [id])

  @@index([tenantId])
  @@map("refunds")
}

model WebhookEvent {
  id               String   @id @default(cuid())
  provider         Provider
  tenantId         String?
  paymentIntentId  String?
  rawPayload       Json     // masked before storage
  headers          Json?
  signatureVerified Boolean  @default(false)
  processed        Boolean   @default(false)
  processingError  String?
  mappedStatus     String?
  idempotencyKey   String?  @unique  // provider event id for deduplication
  createdAt        DateTime @default(now())

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([tenantId])
  @@index([provider])
  @@map("webhook_events")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique  // bcrypt hash — retained for legacy key fallback
  keySha256  String?   @unique  // SHA-256 of raw key — O(1) per-request lookup
  keyPrefix  String             // e.g. "cp_live_xxxx" first 16 chars for display
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@map("audit_logs")
}

model ProviderHealth {
  id        String               @id @default(cuid())
  provider  Provider             @unique
  status    ProviderHealthStatus @default(NORMAL)
  notes     String?
  updatedAt DateTime             @updatedAt

  @@map("provider_health")
}

// ─── Recurring Billing ───────────────────────────────────────────────────────────

model Subscription {
  id                         String             @id @default(cuid())
  tenantId                   String
  customerId                 String             // merchant's customer identifier
  encryptedStoredProfileId   String             // AES-256 encrypted storedPaymentProfileId
  initialPaymentIntentId     String             @unique
  paymentLinkId              String?            // the recurring payment link that created this
  inngestRunId               String?            // active Inngest run ID (for cancellation)
  status                     SubscriptionStatus @default(PENDING)
  amount                     Decimal            @db.Decimal(12, 2)
  currency                   String             @default("MAD")
  intervalType               BillingInterval
  intervalValue              Int                @default(1)
  nextBillingDate            DateTime?
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  trialEndDate               DateTime?
  retryCount                 Int                @default(0)
  maxRetries                 Int                @default(3)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initialPaymentIntent PaymentIntent @relation(fields: [initialPaymentIntentId], references: [id])
  paymentLink         PaymentLink?   @relation(fields: [paymentLinkId], references: [id])
  billingEvents       BillingEvent[]

  @@index([tenantId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model BillingEvent {
  id                 String   @id @default(cuid())
  subscriptionId     String
  chargeId           String
  vpsTransactionId   String?
  inngestRunId       String?
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @default("MAD")
  status             String   // CHARGED, DECLINED, ERROR, PENDING, etc.
  attemptNumber      Int      @default(1)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  processedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_events")
}

// ─── BNPL / Installment Billing ─────────────────────────────────────────────────

model InstallmentPlan {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  durationMonths      Int      // 3, 6, 12, etc.
  annualInterestRate  Decimal  @db.Decimal(6, 4)  // e.g. 12.0000 = 12% APR
  minAmount           Decimal? @db.Decimal(12, 2)
  maxAmount           Decimal? @db.Decimal(12, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreements InstallmentAgreement[]

  @@index([tenantId])
  @@map("installment_plans")
}

model InstallmentAgreement {
  id                         String                     @id @default(cuid())
  tenantId                   String
  customerId                 String
  planId                     String
  paymentLinkId              String?
  initialPaymentIntentId     String                     @unique
  encryptedStoredProfileId   String                     @default("")
  status                     InstallmentAgreementStatus @default(PENDING_CHECKOUT)
  principalAmount            Decimal                    @db.Decimal(12, 2)
  downPayment                Decimal                    @db.Decimal(12, 2)
  installmentAmount          Decimal                    @db.Decimal(12, 2)  // per remaining charge
  totalInstallments          Int                        // total number of charges including down payment
  paidCount                  Int                        @default(0)
  currency                   String                     @default("MAD")
  nextChargeDate             DateTime?
  inngestRunId               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 InstallmentPlan      @relation(fields: [planId], references: [id])
  paymentLink          PaymentLink?         @relation(fields: [paymentLinkId], references: [id])
  initialPaymentIntent PaymentIntent        @relation(fields: [initialPaymentIntentId], references: [id])
  installmentCharges   InstallmentCharge[]

  @@index([tenantId])
  @@index([status])
  @@index([paymentLinkId])
  @@map("installment_agreements")
}

model InstallmentCharge {
  id                String   @id @default(cuid())
  agreementId       String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("MAD")
  status            String   // PENDING, CHARGED, DECLINED, ERROR
  chargeId          String
  vpsTransactionId  String?
  attemptNumber     Int      @default(1)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime @default(now())

  agreement InstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@map("installment_charges")
}

// ─── Ledger / PayFac settlement ─────────────────────────────────────────────────

model LedgerEntry {
  id           String          @id @default(cuid())
  postingId    String          // groups the debit + credit legs of one double-entry posting
  tenantId     String
  account      LedgerAccount
  direction    LedgerDirection
  category     LedgerCategory
  amount       Decimal         @db.Decimal(12, 2) // MAD — centimes at the lib boundary (see src/lib/money.ts)
  currency     String          @default("MAD")
  balanceAfter Decimal         @db.Decimal(12, 2) // running balance snapshot for this account (audit; derived balance is authoritative)
  sourceType   String?
  sourceId     String?
  partyId      String?
  createdAt    DateTime        @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party     SplitParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  payoutItem PayoutItem?

  @@index([postingId])
  @@index([tenantId, account])
  @@index([tenantId, partyId, account])
  @@index([tenantId, sourceType, sourceId])
  @@map("ledger_entries")
}

model FeeSchedule {
  id             String   @id @default(cuid())
  tenantId       String
  version        Int
  name           String?
  feeType        FeeType
  flatCents      Int?     // fixed fee (centimes) — FLAT and PER_METHOD
  percentageBps  Int?     // basis points (290 = 2.9%) — PERCENTAGE and TIERED
  perMethodCents Json?    // { [method]: centimes } — PER_METHOD
  tiersCents     Json?    // [{ upToCents, percentageBps }] — TIERED
  currency       String   @default("MAD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlementPolicies  SettlementPolicy[]

  @@unique([tenantId, version])
  @@index([tenantId, isActive])
  @@map("fee_schedules")
}

model SettlementPolicy {
  id                    String                @id @default(cuid())
  tenantId              String
  version               Int
  name                  String?
  industry              String?               // marketplace | saas | retail | travel | escrow | lending | on_demand
  mcc                   String?               // merchant category code
  availabilityMode      AvailabilityMode      @default(IMMEDIATE)
  availabilityDelayDays Int?
  reserveType           ReserveType           @default(ROLLING)
  reservePercentageBps  Int?                  // basis points (500 = 5%)
  reserveHoldDays       Int?                  // e.g. 30
  reserveFixedCents     Int?
  payoutSchedule        PayoutSchedule        @default(AUTO_DAILY)
  payoutMinCents        Int?                  // THRESHOLD
  reversalFunding       ReversalFundingPolicy @default(NET_FROM_AVAILABLE)
  allowNegative         Boolean               @default(false)
  splittingEnabled      Boolean               @default(false)
  feeScheduleId         String?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, version])
  @@index([tenantId, isActive])
  @@map("settlement_policies")
}

model Payout {
  id                 String        @id @default(cuid())
  tenantId           String
  amount             Decimal       @db.Decimal(12, 2) // MAD — centimes at the lib boundary
  currency           String        @default("MAD")
  status             PayoutStatus  @default(DRAFT)
  provider           Provider
  providerTransferId String?
  feeAmount          Decimal       @db.Decimal(12, 2) @default(0)
  method             PayoutMethod  @default(BANK_TRANSFER)
  idempotencyKey     String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PayoutItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("payouts")
}

model PayoutItem {
  id            String   @id @default(cuid())
  payoutId      String
  ledgerEntryId String   @unique // each AVAILABLE entry settled at most once (no double-payout)
  amount        Decimal  @db.Decimal(12, 2)

  payout      Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("payout_items")
}

model Dispute {
  id                String        @id @default(cuid())
  tenantId          String
  paymentIntentId   String?
  provider          Provider
  providerDisputeId String
  status            DisputeStatus @default(OPEN)
  amount            Decimal       @db.Decimal(12, 2) // MAD — gross amount clawed back (centimes at the lib boundary)
  feeAmount         Decimal       @db.Decimal(12, 2) @default(0) // provider dispute fee
  currency          String        @default("MAD")
  reason            String?
  evidenceDueDate   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  recovery      Recovery?

  @@unique([tenantId, providerDisputeId])
  @@index([tenantId, status])
  @@map("disputes")
}

model Recovery {
  id        String         @id @default(cuid())
  tenantId  String
  disputeId String         @unique
  status    RecoveryStatus @default(PENDING)
  amount    Decimal        @db.Decimal(12, 2) // MAD — the uncovered clawback the tenant owes
  currency  String         @default("MAD")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("recoveries")
}

model SplitParty {
  id        String         @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  type      SplitPartyType @default(SUB_MERCHANT)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  splits        Split[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("split_parties")
}

model SplitRule {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  trigger   SplitTrigger @default(AT_CAPTURE)
  shares    Json
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  splits Split[]

  @@index([tenantId, isActive])
  @@map("split_rules")
}

model Split {
  id          String      @id @default(cuid())
  tenantId    String
  splitRuleId String?
  sourceType  String
  sourceId    String
  partyId     String
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("MAD")
  status      SplitStatus @default(PENDING)
  heldUntil   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  splitRule SplitRule? @relation(fields: [splitRuleId], references: [id], onDelete: SetNull)
  party     SplitParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
  @@map("splits")
}

// ─── Reconciliation (three-way match: provider reports ↔ ledger ↔ payouts) ──────

model ReconciliationReport {
  id          String               @id @default(cuid())
  tenantId    String
  provider    Provider
  currency    String               @default("MAD")
  periodStart DateTime?
  periodEnd   DateTime?
  status      ReconciliationStatus @default(PENDING)
  summary     Json?                 // persisted reconcile result (counts, totals, breaks)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  ReconciliationLine[]

  @@index([tenantId, status])
  @@map("reconciliation_reports")
}

model ReconciliationLine {
  id               String                    @id @default(cuid())
  reportId         String
  reference        String
  amount           Decimal                   @db.Decimal(12, 2) // MAD — external (provider) amount
  currency         String                    @default("MAD")
  status           ReconciliationMatchStatus @default(UNMATCHED)
  matchedAmount    Decimal?                  @db.Decimal(12, 2) // internal (ledger) amount matched
  differenceAmount Decimal?                  @db.Decimal(12, 2) // external − internal (signed)
  createdAt        DateTime                  @default(now())

  report ReconciliationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("reconciliation_lines")
}

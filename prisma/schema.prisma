// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  DISABLED
}

enum Environment {
  SANDBOX
  PRODUCTION
}

enum UserRole {
  OWNER
  STAFF
  SUPPORT_ADMIN
  SUPER_ADMIN
}

enum Provider {
  NAPS
  VPS
  STRIPE
  PAYPAL
  ADYEN
}

enum ProviderConfigStatus {
  CONNECTED
  INVALID
  MISSING
}

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ProviderHealthStatus {
  NORMAL
  DEGRADED
  DOWN
}

enum AuditAction {
  PROVIDER_CONFIG_CREATED
  PROVIDER_CONFIG_UPDATED
  PROVIDER_CONFIG_DELETED
  PROVIDER_CONFIG_VALIDATED
  REFUND_INITIATED
  REFUND_SUCCEEDED
  REFUND_FAILED
  API_KEY_CREATED
  API_KEY_REVOKED
  TENANT_DISABLED
  TENANT_ENABLED
  USER_INVITED
  USER_ROLE_CHANGED
  USER_REMOVED
  PAYMENT_LINK_CANCELED
}

// ─── Models ─────────────────────────────────────────────────────────────────────

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  status           TenantStatus @default(ACTIVE)
  environment      Environment  @default(SANDBOX)
  notifyEmail      String?      // optional: send payment outcome emails via configured adapter
  notifyWebhookUrl String?      // optional: outbound webhook URL for real-time payment events
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users           User[]
  providerConfigs ProviderConfig[]
  paymentLinks    PaymentLink[]
  paymentIntents  PaymentIntent[]
  refunds         Refund[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  webhookEvents   WebhookEvent[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds   Refund[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model ProviderConfig {
  id                   String               @id @default(cuid())
  tenantId             String
  provider             Provider
  encryptedCredentials String               // AES-256 encrypted JSON
  status               ProviderConfigStatus @default(MISSING)
  environment          Environment          @default(SANDBOX)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("provider_configs")
}

model PaymentLink {
  id            String            @id @default(cuid())
  tenantId      String
  slug          String            @unique @default(cuid())
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("MAD")
  description   String
  reference     String
  customerName  String?
  customerEmail String?
  customerPhone String?
  provider      Provider
  status        PaymentLinkStatus @default(ACTIVE)
  maxAttempts   Int               @default(1)
  attemptCount  Int               @default(0)
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentIntents PaymentIntent[]

  @@index([tenantId])
  @@index([slug])
  @@map("payment_links")
}

model PaymentIntent {
  id             String              @id @default(cuid())
  tenantId       String
  paymentLinkId  String?             // null for direct/programmatic payment intents (no Payment Link)
  status         PaymentIntentStatus @default(CREATED)
  provider       Provider
  providerRef    String?
  correlationId  String              @unique @default(cuid())
  customerIp     String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentLink       PaymentLink?        @relation(fields: [paymentLinkId], references: [id])
  providerTxs       ProviderTransaction[]
  refunds           Refund[]
  webhookEvents     WebhookEvent[]

  @@index([tenantId])
  @@index([providerRef])
  @@map("payment_intents")
}

model ProviderTransaction {
  id                    String   @id @default(cuid())
  paymentIntentId       String
  provider              Provider
  providerTransactionId String?
  rawRequest            Json?    // masked before storage
  rawResponse           Json?    // masked before storage
  createdAt             DateTime @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
  @@map("provider_transactions")
}

model Refund {
  id               String       @id @default(cuid())
  paymentIntentId  String
  tenantId         String
  initiatedBy      String       // userId
  status           RefundStatus @default(PENDING)
  providerRefundRef String?
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("MAD")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiator     User          @relation(fields: [initiatedBy], references: [id])

  @@index([tenantId])
  @@map("refunds")
}

model WebhookEvent {
  id               String   @id @default(cuid())
  provider         Provider
  tenantId         String?
  paymentIntentId  String?
  rawPayload       Json     // masked before storage
  headers          Json?
  signatureVerified Boolean  @default(false)
  processed        Boolean   @default(false)
  processingError  String?
  mappedStatus     String?
  idempotencyKey   String?  @unique  // provider event id for deduplication
  createdAt        DateTime @default(now())

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([tenantId])
  @@index([provider])
  @@map("webhook_events")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique // bcrypt hash of the raw key
  keyPrefix  String    // e.g. "cp_live_xxxx" first 12 chars for display
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@map("audit_logs")
}

model ProviderHealth {
  id        String               @id @default(cuid())
  provider  Provider             @unique
  status    ProviderHealthStatus @default(NORMAL)
  notes     String?
  updatedAt DateTime             @updatedAt

  @@map("provider_health")
}

{
  "name": "corpopay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CorpoPay backend API – Express + Prisma + serverless-http",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src prisma",
    "format:check": "prettier --check src prisma",
    "prepare": "husky",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "contract:generate": "npm run openapi:generate && openapi-typescript contract/openapi.json -o contract/api-types.d.ts && node scripts/generate-enums.mjs",
    "migrate:prod": "prisma migrate deploy"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-sqs": "^3.1111.0",
    "@aws-sdk/client-ssm": "^3.1116.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-stringify": "^6.4.6",
    "datadog-lambda-js": "^12.142.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "inngest": "^3.54.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "serverless-http": "^3.2.0",
    "stripe": "^16.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@datadog/datadog-ci": "^5.23.0",
    "@types/aws-lambda": "^8.10.136",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "prisma/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}

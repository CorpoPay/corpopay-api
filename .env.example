# ─────────────────────────────────────────────────────────────────────────────────
# This file is a FALLBACK for local dev without an external secrets manager.
# In CI/CD and production, secrets are injected via the environment.
# Local dev: fill in this file and run `npm run dev`
# ─────────────────────────────────────────────────────────────────────────────────

# ─── Database ───────────────────────────────────────────────────────────────────
# Local dev : both vars point to the same local postgres.
# Production: DATABASE_URL = pooler URL with ?pgbouncer=true
#              DIRECT_URL   = direct TCP URL (no pgbouncer) — used by Prisma Migrate
DATABASE_URL="postgresql://corpopay:corpopay@localhost:5432/corpopay?schema=public"
DIRECT_URL="postgresql://corpopay:corpopay@localhost:5432/corpopay?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── Credential encryption ───────────────────────────────────────────────────────
# 32-byte hex key (openssl rand -hex 32)
ENCRYPTION_KEY="change-me-32-byte-hex-string-here"

# ─── Webhooks ────────────────────────────────────────────────────────────────────
NAPS_WEBHOOK_SECRET="naps-shared-secret"
VPS_WEBHOOK_SECRET="vps-shared-secret"

# ─── Seed (demo VPS sandbox credentials — local dev only) ───────────────────
# Set these only if you want `npm run db:seed` to create a working demo VPS config.
SEED_VPS_PAYWALL_SECRET=""
SEED_VPS_CALLER_PASSWORD=""
SEED_VPS_NOTIFICATION_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="4000"
# Full public URL of the API (used for webhook URLs shown in dashboard)
API_BASE_URL="http://localhost:4000"
# Full public URL of the web app (used for checkout redirect URLs)
WEB_BASE_URL="http://localhost:3000"

# ─── Frontend ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── AWS (production only) ────────────────────────────────────────────────────────
AWS_REGION="eu-west-1"
AWS_ACCOUNT_ID=""

# ─── Inngest ─────────────────────────────────────────────────────────────────────
# Get from https://app.inngest.com → Your App → Event Keys & Signing Keys.
# Leave blank for local dev — the Inngest Dev Server handles auth automatically.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Datadog (CDK deploy-time only) ─────────────────────────────────────────────
# Consumed by the Datadog CDK construct (cdk/lib/corpopay-api-stack.ts) at
# synth/deploy time via your deployment tooling — NOT read by the app
# runtime. Set DD_API_KEY in your staging/production environment (never here).
DD_API_KEY=""

{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/generated/**", "!dist/**", "!coverage/**", "!.serverless/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
